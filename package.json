{
  "name": "ai-agent-handbook",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/build-challenges.mjs && vitepress dev --host 127.0.0.1",
    "build": "node scripts/build-challenges.mjs && vitepress build",
    "preview": "vitepress preview --host 127.0.0.1",
    "check": "node scripts/check-book.mjs && npm run check:challenges",
    "check:challenges": "node challenges/01-refund-timeout/tests/run-tests.mjs && node challenges/02-resume/tests/run-tests.mjs && node challenges/03-memory/tests/run-tests.mjs && node challenges/04-efficiency/tests/run-tests.mjs",
    "check:build": "node scripts/check-build.mjs",
    "test": "playwright test"
  },
  "overrides": {
    "vite": "6.4.5",
    "esbuild": "0.25.12",
    "katex": "0.18.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "cheerio": "1.1.2",
    "markdown-it": "14.3.3",
    "markdown-it-mathjax3": "4.3.2",
    "mermaid": "12.1.0",
    "vitepress": "1.6.4",
    "vue": "3.5.43"
  }
}
